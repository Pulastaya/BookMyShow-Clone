        },
        {
            "type": "java",
            "name": "Notification Service",
            "request": "launch",
            "mainClass": "com.example.demo.NotificationServiceApplication",
            "projectName": "notification-service",
            "cwd": "${workspaceFolder}/notification-service",
            "vmArgs": "-XX:+TieredCompilation -XX:TieredStopAtLevel=1",
            "env": {
                "RABBITMQ_HOST": "localhost",
                "RABBITMQ_PORT": "5672",
                "EUREKA_INSTANCE_PREFER_IP_ADDRESS": "false",
                "SMTP_USERNAME": "bmsclonee@gmail.com",
                "SMTP_PASSWORD": "ueyp slnw gjzv zmge"
            }
        },
        {
            "type": "java",
            "name": "API Gateway",
            "request": "launch",
            "mainClass": "com.example.demo.ApiGatewayApplication",
            "projectName": "api-gateway",
            "cwd": "${workspaceFolder}/api-gateway",
            "vmArgs": "-XX:+TieredCompilation -XX:TieredStopAtLevel=1",
            "env": {
                "EUREKA_INSTANCE_PREFER_IP_ADDRESS": "false"
            }
        },
        {
            "type": "node",
            "name": "React Frontend",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Run All Services",
            "configurations": [
                "Eureka Server",
                "Movie Service",
                "Booking Service",
                "Notification Service",
                "API Gateway",
                "React Frontend"
            ]
        }
    ]
}
